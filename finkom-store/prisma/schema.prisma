generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Unit {
  PCS
  M2
  M
  KG
  L
  PACK
  BAG
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  external1cId String?  @unique
  sku          String   @unique
  name         String
  slug         String   @unique
  description  String?

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  baseUnit     Unit
  saleUnit     Unit
  priceUnit    Unit

  price        Decimal
  stockQty     Decimal

  minQty       Decimal
  stepQty      Decimal
  packSize     Decimal?

  isActive     Boolean  @default(true)

  images       ProductImage[]
  orderItems   OrderItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url       String
  alt       String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
}
enum OrderStatus {
  NEW
  CONFIRMED
  RESERVED
  COMPLETED
  CANCELED
}

enum DeliveryType {
  PICKUP
  ADDRESS
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  status          OrderStatus     @default(NEW)

  customerName    String
  customerPhone   String

  deliveryType    DeliveryType
  deliveryAddress DeliveryAddress?

  total           Decimal

  items           OrderItem[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())

  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId  String
  product    Product @relation(fields: [productId], references: [id])

  sku        String
  name       String

  price      Decimal
  quantity   Decimal

  baseUnit   Unit
  saleUnit   Unit
  priceUnit  Unit
  packSize   Decimal?

  lineTotal  Decimal

  createdAt  DateTime @default(now())
}

model DeliveryAddress {
  id        String @id @default(cuid())

  orderId   String @unique
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  city      String
  street    String?
  building  String?
  apartment String?
  entrance  String?
  floor     String?
  comment   String?

  createdAt DateTime @default(now())
}